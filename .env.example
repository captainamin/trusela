# ============================================================
# Trusela — Required Environment Variables
# Copy this file, fill in real values, and set them in Render
# ============================================================

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Service Account JSON (stringify the entire JSON as one line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Paystack (use sk_live_... for production)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# App URL — set to your Render URL after deploying
APP_URL=https://your-app-name.onrender.com

# Node environment
NODE_ENV=production
